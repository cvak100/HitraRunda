// Ročni rollback — Build with Parameters.
pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    timestamps()
  }
  parameters {
    choice(
      name: 'RESTORE_DB',
      choices: ['true', 'false'],
      description: 'Obnovi tudi Postgres dump iz previous-backup'
    )
    string(
      name: 'APP_DIR',
      defaultValue: '/opt/dockerapps/hitrarunda',
      description: 'Pot do produkcijske namestitve'
    )
    string(
      name: 'BACKUP_ROOT',
      defaultValue: '/opt/dockerapps/hitrarunda-backups',
      description: 'Mapa za pg_dump + deploy state'
    )
    choice(
      name: 'INSTALL_MODE',
      choices: ['http', 'https'],
      description: 'Enako kot Deploy (pri Apache httpd: http)'
    )
  }
  stages {
    stage('Rollback') {
      steps {
        sh """
          set -euo pipefail
          export APP_DIR='${params.APP_DIR}'
          export BACKUP_ROOT='${params.BACKUP_ROOT}'
          export RESTORE_DB='${params.RESTORE_DB}'
          export INSTALL_MODE='${params.INSTALL_MODE}'
          bash "\${WORKSPACE}/deploy/jenkins/rollback.sh"
        """
      }
    }
  }
}
