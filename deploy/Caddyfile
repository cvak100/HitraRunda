{
	email {$TLS_EMAIL}
}

{$APP_DOMAIN} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
	# API / WS / admin naravnost na backend — pravi X-Forwarded-* (ne prek nginx).
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy backend:8000
	}
	handle /admin/* {
		header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
		header Permissions-Policy "geolocation=(), microphone=(), camera=()"
		header X-Frame-Options "DENY"
		header X-Content-Type-Options "nosniff"
		header Referrer-Policy "strict-origin-when-cross-origin"
		reverse_proxy backend:8000
	}
	handle /static/* {
		reverse_proxy backend:8000
	}
	handle {
		reverse_proxy frontend_tls:80
	}
}
