// Ročni deploy — Build with Parameters. Agent na istem hostu kot app.
pipeline {
  agent any
  options {
    disableConcurrentBuilds()
    timestamps()
  }
  parameters {
    string(
      name: 'DEPLOY_REF',
      defaultValue: 'main',
      description: 'Git branch ali tag (brez */): main, feature/0.5, v0.4.37'
    )
    string(
      name: 'APP_DIR',
      defaultValue: '/opt/dockerapps/hitrarunda',
      description: 'Pot do produkcijske namestitve'
    )
    string(
      name: 'BACKUP_ROOT',
      defaultValue: '/opt/dockerapps/hitrarunda-backups',
      description: 'Mapa za pg_dump + deploy state'
    )
  }
  stages {
    stage('Deploy') {
      steps {
        sh """
          set -euo pipefail
          export APP_DIR='${params.APP_DIR}'
          export BACKUP_ROOT='${params.BACKUP_ROOT}'
          export DEPLOY_REF='${params.DEPLOY_REF}'
          bash "\${WORKSPACE}/deploy/jenkins/deploy.sh"
        """
      }
    }
  }
}
