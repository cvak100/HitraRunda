# === Hitra runda — produkcija ===
# 1) cp .env.prod.example .env
# 2) uredi spodnje vrednosti
# 3) ./deploy/install.sh http   ALI   ./deploy/install.sh https

# Javni naslov aplikacije (obvezno). Določi tudi HTTP vs HTTPS piškotke.
# Primeri:
#   APP_URL=http://192.168.1.10:5008
#   APP_URL=http://igra.local:5008
#   APP_URL=https://igra.primer.si
APP_URL=http://localhost:5008

# Samo za HTTP način (neposredni port na frontend).
APP_PORT=5008

# Samo za HTTPS (Let's Encrypt prek Caddy). Mora ujemati domeno v APP_URL.
# APP_DOMAIN=igra.primer.si
# TLS_EMAIL=admin@primer.si

POSTGRES_DB=hitrarunda
POSTGRES_USER=hitrarunda
POSTGRES_PASSWORD=zamenjaj-močno-geslo

DJANGO_SECRET_KEY=zamenjaj-dolg-naključen-niz

# Opcijsko — prepiše datoteko VERSION (sicer backend/VERSION).
# APP_VERSION=0.5.38

# Opcijsko — če prazno, se izpelje iz APP_URL.
# DJANGO_ALLOWED_HOSTS=
# DJANGO_CSRF_TRUSTED_ORIGINS=
# DJANGO_COOKIE_SECURE=

# Opcijski admin (ustvari se ob prvem zagonu, če oboje nastaviš).
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=zamenjaj-admin-geslo

# E-pošta (ponastavitev gesla)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=noreply@example.com
CONTACT_EMAIL=feedback@example.com

# Sentry (opcijsko)
# SENTRY_DSN=
# VITE_SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
