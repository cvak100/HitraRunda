# Kopiraj v .env samo, če hočeš prepisati privzete vrednosti.
# Razvoj na Windowsu in zagon na Fedori uporabljata iste imena.

APP_PORT=5008

POSTGRES_DB=hitrarunda
POSTGRES_USER=hitrarunda
POSTGRES_PASSWORD=hitrarunda

DJANGO_SECRET_KEY=zamenjaj-me-na-fedori
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5008,http://127.0.0.1:5008

# Lokalni admin. Na Fedori geslo zamenjaj.
DJANGO_SUPERUSER_EMAIL=admin@hitrarunda.local
DJANGO_SUPERUSER_PASSWORD=admin12345

# Javni URL (povezave v e-pošti za ponastavitev gesla).
APP_URL=http://localhost:5008

# E-pošta (privzeto console — glej log backend). Za SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=noreply@hitrarunda.local

# Sentry (opcijsko)
# SENTRY_DSN=
# VITE_SENTRY_DSN=
